        <!-- Komposition: Car 1 ◆—— 1 Engine -->
        <mxCell id="comp" value="" style="endArrow=none;startArrow=diamondThin;startFill=1;startSize=16;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="car" target="engine">

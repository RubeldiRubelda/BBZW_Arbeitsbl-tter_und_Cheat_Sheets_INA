        <!-- Vererbung: Bicycle -> Vehicle -->
        <mxCell id="gen_bike" value="" style="endArrow=block;endFill=0;endSize=14;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="bicycle" target="vehicle">
          <mxGeometry relative="1" as="geometry" />

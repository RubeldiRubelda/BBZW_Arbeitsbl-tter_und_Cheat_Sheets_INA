        <mxCell id="vehicle" value="Vehicle" style="swimlane;fontStyle=3;align=center;startSize=26;horizontal=1;collapsible=0;marginBottom=0;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">

        <!-- Aggregation: Garage 0..1 ◇—— 0..* Vehicle -->
        <mxCell id="agg" value="" style="endArrow=none;startArrow=diamondThin;startFill=0;startSize=16;html=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="garage" target="vehicle">
